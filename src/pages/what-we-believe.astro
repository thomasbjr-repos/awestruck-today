---
// The full statement goes here once pastors and reviewers approve it (Concept Brief, "Review and accountability").
// Until then the page names the four convictions the Brief lists and says the statement is coming.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="What We Believe — Awestruck Today" description="The convictions behind Awestruck Today.">
  <section class="pagehead band">
    <Header current="believe" />
    <div class="wrap">
      <span class="kicker">What We Believe</span>
      <h1 class="serif">Grounded in <i>historic</i> faith.</h1>
      <p>A short statement of faith, grounded in historic Christian orthodoxy.</p>
    </div>
  </section>
  <div class="prose read">
    <p>Awestruck Today stands on four convictions:</p>
    <ul>
      <li>The authority of Scripture</li>
      <li>The Trinity: one God, Father, Son and Holy Spirit</li>
      <li>Salvation by grace through faith in Christ</li>
      <li>The resurrection</li>
    </ul>
    <p class="src">Our full statement is being reviewed by pastors and will be published here before launch on November 28, 2026.</p>
  </div>
</Base>
